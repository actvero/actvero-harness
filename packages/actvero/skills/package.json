{
  "name": "@actvero/dsh-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contracts": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./package.json": "./package.json",
    "./main": {
      "types": "./lib/types/main.d.ts",
      "default": "./lib/main.js"
    },
    "./local": {
      "types": "./lib/types/local.d.ts",
      "default": "./lib/local.js"
    },
    "./package": {
      "types": "./lib/types/package.d.ts",
      "default": "./lib/package.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@actvero/dsh-capability-ui",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@actvero/dsh-capability-ui": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-input-trigger": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-commands": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-util-workspace-path": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "bundle": "tsdown"
  }
}
