      "path": "../../../vendor/cordis/tsconfig.json"
    },
    {
      "path": "../../core/agent/tsconfig.json"
    },
    {
      "path": "../../core/tools/tsconfig.json"
    }
  ],
  "exclude": [
    "src/client"
  ]
}
