{
  "name": "@actvero/dsh-experts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contracts": {
      "types": "./lib/types/contracts.d.ts",
      "default": "./lib/contracts.js"
    },
    "./package.json": "./package.json",
    "./schema": {
      "types": "./lib/types/schema.d.ts",
      "default": "./lib/schema.js"
    },
    "./main": {
      "types": "./lib/types/main.d.ts",
      "default": "./lib/main.js"
    },
    "./creator": {
      "types": "./lib/types/creator.d.ts",
      "default": "./lib/creator.js"
    },
    "./remote-contract": {
      "types": "./lib/types/remote-contract.d.ts",
      "default": "./lib/remote-contract.js"
    },
    "./remote-types": {
      "types": "./lib/types/remote-types.d.ts",
      "default": "./lib/remote-types.js"
    },
    "./categories": {
      "types": "./lib/types/categories.d.ts",
      "default": "./lib/categories.js"
    },
    "./remote-main": {
      "types": "./lib/types/remote-main.d.ts",
      "default": "./lib/remote-main.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@actvero/dsh-capability-ui",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@actvero/dsh-capability-ui": "workspace:~",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-api-workspace-controller": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-commands": "workspace:*",
    "@actvero/dsh-connectors": "workspace:~",
    "@actvero/dsh-skills": "workspace:~",
    "@deepseek-ai/dsh-session-projection": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "bundle": "tsdown"
  }
}
