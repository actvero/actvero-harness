{
  "name": "dsh-desktop-workbenches",
  "version": "0.1.0",
  "description": "Awesome workbench catalog, pinned navigation and native conversation frame for DSH Desktop.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dataelement/dsh-desktop",
    "directory": "packages/dsh-desktop-workbenches"
  },
  "dependencies": {},
  "files": [
    "*.js",
    "*.mjs",
    "*.mts",
    "*.md",
    "assets",
    "LICENSE"
  ]
}
